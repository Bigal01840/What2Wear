# Copy to .env and fill in. Never commit .env.

# The passcode you both type once on each phone.
HOUSEHOLD_PASSCODE=change-me-to-something-long

# Where the SQLite file and photos live (default ./data).
DATA_DIR=./data

# Port and bind address. On a Pi, set HOST to the machine's Tailscale IP (tailscale ip -4)
# so it is only reachable over Tailscale.
PORT=3000
HOST=127.0.0.1

# Optional: serve HTTPS directly with a `tailscale cert` certificate.
# TLS_CERT=/home/pi/certs/pi.tailnet-name.ts.net.crt
# TLS_KEY=/home/pi/certs/pi.tailnet-name.ts.net.key

# Web Push. If left blank, keys are generated once into $DATA_DIR/vapid.json.
VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
