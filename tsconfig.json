{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client", "vite-plugin-pwa/client"]
  },
  "include": ["shared", "server", "scripts/*.ts", "tests", "web/src", "web/vite.config.ts", "vitest.config.ts"],
  "exclude": ["web/src/sw.ts"]
}
