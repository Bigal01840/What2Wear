{
  "name": "sleep-outfit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sleep Outfit Assistant: a private two-parent PWA that picks what a toddler wears to bed.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c red,gray \"tsx watch server/main.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/server/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.sw.json --noEmit",
    "seed": "tsx scripts/seed.ts",
    "icons": "node scripts/make-icons.mjs",
    "backup": "sh scripts/backup.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.13",
    "sharp": "^0.34.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "esbuild": "^0.25.12",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
